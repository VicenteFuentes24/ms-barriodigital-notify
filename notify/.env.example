# Spring Boot does NOT automatically load this file. Export variables or use Compose --env-file.
SERVER_PORT=8087
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VIRTUAL_HOST=barriodigital
# For Compose, RabbitMQ is on the existing external network.
BARRIODIGITAL_NETWORK_NAME=infra-barriodigital_barriodigital-net

# Mailpit catches real SMTP messages locally; it never delivers to the Internet.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@barriodigital.test
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
MAILPIT_UI_PORT=8025

NOTIFY_STORAGE_DIR=./data
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_RETRY_DELAY_MS=1000
NOTIFY_LISTENERS_AUTO_STARTUP=true

# Opt-in test only. Requires a management administrator; test creates a temporary vhost.
NOTIFY_INTEGRATION_TEST=false
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
NOTIFY_TEST_MAILPIT_URL=http://localhost:8025
# Optional absolute path; default is the existing Infra file two directories above Notify.
RABBITMQ_DEFINITIONS_FILE=
